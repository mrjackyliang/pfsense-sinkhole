{
  "name": "pfsense-sinkhole-docs",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "nova utility run-scripts --parallel --node-env development \"dev:*\"",
    "dev:start": "docusaurus start --port 3000",
    "prod": "nova utility run-scripts --sequential --node-env production \"prod:*\"",
    "prod:serve": "docusaurus serve --dir build --port 3000",
    "check": "nova utility run-scripts --sequential \"check:*\"",
    "check:lint": "eslint ./ --max-warnings=0",
    "check:types-app": "nova utility type-check --project tsconfig.app.json",
    "check:types-config": "nova utility type-check --project tsconfig.config.json",
    "check:types-tests": "nova utility type-check --project tsconfig.tests.json",
    "check:test": "vitest run",
    "build": "nova utility run-scripts --sequential --node-env production \"build:*\"",
    "build:build": "docusaurus build --out-dir build",
    "clean": "nova utility run-scripts --sequential \"clean:*\"",
    "clean:build": "shx rm -rf ./build",
    "clean:clear": "docusaurus clear",
    "i18n": "nova utility run-scripts --sequential \"i18n:*\"",
    "i18n:sync": "theme-nova i18n sync",
    "i18n:check": "theme-nova i18n check",
    "i18n:coverage": "theme-nova i18n coverage"
  },
  "engines": {
    "node": "^22 || ^24 || ^26"
  },
  "dependencies": {
    "@cbnventures/docusaurus-preset-nova": "0.39.0",
    "@cbnventures/nova": "0.39.0",
    "@docusaurus/core": "3.10.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "glob": "13.0.6",
    "shx": "0.4.0",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
