      },
      "sync-identity": {
        "enabled": true
      },
      "sync-labels": {
        "enabled": true
      },
      "sync-policies": {
        "enabled": true
      },
      "sync-rulesets": {
        "enabled": true
      },
      "sync-security": {
        "enabled": true
      }
    },
    "license": {
      "update-copyright": {
        "enabled": true
      }
    },
    "miscellaneous": {
      "fix-markdown-tables": {
        "enabled": true
      },
      "remove-operating-system-files": {
        "enabled": false,
        "settings": {
          "linux": {},
          "macos": {
            "appleDouble": false,
            "desktopServicesStore": false
          },
          "windows": {
            "enhancedThumbnailDatabase": false,
            "enhancedVistaThumbnailDatabase": false,
            "thumbnailDatabase": false
          }
