          }
        },
        "normalize-modules": {
          "enabled": true
        },
        "normalize-tooling": {
          "enabled": true
        },
        "sync-environment": {
          "enabled": true,
          "settings": {
            "trackNodeLtsVersions": true
          }
        },
        "sync-identity": {
