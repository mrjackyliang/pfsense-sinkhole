            "reorderKeys": true
          }
        },
        "normalize-artifacts": {
          "enabled": true
        },
        "normalize-bundler": {
          "enabled": true
        },
        "normalize-dependencies": {
          "enabled": true,
          "settings": {
            "pinDependencyVersions": true,
            "pinDevDependencyVersions": true
          }
        },
        "normalize-modules": {
          "enabled": true
        },
        "normalize-tooling": {
          "enabled": true
        },
        "sync-environment": {
          "enabled": true,
