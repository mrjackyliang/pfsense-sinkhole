{
  "project": {
    "name": {
      "slug": "pfsense-sinkhole",
      "title": "Sinkhole for pfSense"
    },
    "description": {
      "short": "Sinkhole blocks unwanted websites on your pfSense network, with separate block lists for each network or device.",
      "long": "Sinkhole for pfSense is a native package that blocks unwanted websites with block lists for the whole network, each VLAN or a single device. It keeps the lists on the firewall, so DNS answers right after a restart or reload while updates download in the background, and alerts arrive through pfSense's own notifications only where you set them."
    },
    "keywords": [
      "pfsense",
      "pfsense-package",
      "dns",
      "dns-sinkhole",
      "blocklist",
      "unbound",
      "vlan",
      "parental-controls"
    ],
    "legalName": "Jacky Liang",
    "pronouns": "personal",
    "platforms": [
      "nodejs",
      "php",
      "pfsense",
      "web"
    ],
    "startingYear": 2026,
    "license": "MIT"
  },
  "entities": [
    {
      "name": "Jacky Liang",
      "email": "hello@mrjackyliang.com",
      "url": "https://www.mrjackyliang.com/",
      "roles": [
        "author"
      ]
    }
  ],
  "emails": {
    "bugs": "bugs@mrjackyliang.com"
  },
  "github": {
    "owner": "mrjackyliang",
    "repo": "pfsense-sinkhole",
    "topics": [
      "pfsense",
      "pfsense-package",
      "dns",
      "dns-sinkhole",
      "blocklist",
      "unbound",
      "vlan",
      "parental-controls"
    ],
    "features": {
      "issues": true,
      "wiki": false,
      "projects": false,
      "discussions": false,
      "sponsorships": true
    },
    "policies": {
      "visibility": "public",
      "defaultBranch": "main",
      "mergeMethods": {
        "merge": true,
        "squash": true,
        "rebase": true
      },
      "mergeCommit": {
        "title": "merge-message",
        "message": "pull-request-title"
      },
      "squashMerge": {
        "title": "commit-or-pull-request-title",
        "message": "commit-messages"
      },
      "autoDeleteHeadBranch": true,
      "autoMerge": false,
      "allowUpdateBranch": false,
      "webCommitSignoffRequired": false
    },
    "security": {
      "vulnerabilityAlerts": true,
      "dependabotSecurityUpdates": false,
      "secretScanning": true,
      "pushProtection": true
    },
    "rulesets": {
      "defaultBranch": {
        "enforcement": "active",
        "blockDeletions": true,
        "blockForcePushes": true,
        "requireLinearHistory": false,
        "requireSignedCommits": true,
        "requirePullRequest": false,
        "requiredStatusChecks": [],
        "requireBranchesToBeUpToDate": false
      }
    },
    "actions": {
      "enabled": true,
      "allowedActions": "all",
      "shaPinningRequired": false,
      "defaultWorkflowPermissions": "read",
      "canApprovePullRequestReviews": false,
      "artifactRetentionDays": 7
    },
    "labels": [
      {
        "name": "bug",
        "color": "d73a4a",
        "description": "Something isn't working"
      },
      {
        "name": "documentation",
        "color": "0075ca",
        "description": "Improvements or additions to documentation"
      },
      {
        "name": "duplicate",
        "color": "cfd3d7",
        "description": "This issue or pull request already exists"
      },
      {
        "name": "enhancement",
        "color": "a2eeef",
        "description": "New feature or request"
      },
      {
        "name": "good first issue",
        "color": "7057ff",
        "description": "Good for newcomers"
      },
      {
        "name": "help wanted",
        "color": "008672",
        "description": "Extra attention is needed"
      },
      {
        "name": "invalid",
        "color": "e4e669",
        "description": "This doesn't seem right"
      },
      {
        "name": "question",
        "color": "d876e3",
        "description": "Further information is requested"
      },
      {
        "name": "wontfix",
        "color": "ffffff",
        "description": "This will not be worked on"
      }
    ],
    "issueTemplate": {
      "bugReportFields": [
        "php",
        "pfsense"
      ]
    }
  },
  "workflows": [
    {
      "template": "check-sponsor-gated-issues",
      "name": "sponsor-check",
      "triggers": [
        "issue-comment",
        "issues"
      ],
      "runsOn": "ubuntu-latest",
      "timeoutMinutes": 5
    },
    {
      "template": "lock-inactive-issues",
      "name": "lock-inactive",
      "triggers": [
        "schedule-weekly"
      ],
      "runsOn": "ubuntu-latest",
      "timeoutMinutes": 5
    },
    {
      "template": "publish",
      "name": "project",
      "triggers": [
        "release"
      ],
      "runsOn": "ubuntu-latest",
      "timeoutMinutes": 15,
      "build": [
        "./apps/docs"
      ],
      "deploy": [
        {
          "to": "github-pages",
          "path": "./apps/docs",
          "artifact": "pfsense-sinkhole-docs"
        }
      ]
    }
  ],
  "urls": {
    "homepage": "https://mrjackyliang.github.io/pfsense-sinkhole/",
    "repository": "git+https://github.com/mrjackyliang/pfsense-sinkhole.git",
    "bugs": "https://github.com/mrjackyliang/pfsense-sinkhole/issues",
    "license": "https://github.com/mrjackyliang/pfsense-sinkhole/blob/HEAD/LICENSE",
    "logo": "https://mrjackyliang.github.io/pfsense-sinkhole/images/logo.svg",
    "documentation": "https://mrjackyliang.github.io/pfsense-sinkhole/",
    "fundSources": [
      "https://github.com/sponsors/mrjackyliang",
      "https://liang.nyc/paypal"
    ]
  },
  "readme": {
    "badges": [
      "github-release",
      "github-top-language",
      "github-license",
      "funding"
    ]
  },
  "workspaces": {
    "./": {
      "name": "pfsense-sinkhole-project",
      "role": "project",
      "policy": "freezable"
    },
    "./packages/sinkhole": {
      "name": "pfsense-pkg-sinkhole",
      "role": "package",
      "policy": "distributable"
    },
    "./apps/docs": {
      "name": "pfsense-sinkhole-docs",
      "role": "docs",
      "policy": "freezable"
    }
  },
  "artifacts": {
    "pfsense-pkg-sinkhole": {
      "build": [
        "./packages/sinkhole"
      ],
      "sources": [
        {
          "from": "./packages/sinkhole/build",
          "to": "./"
        }
      ]
    },
    "pfsense-sinkhole-docs": {
      "build": [
        "./apps/docs"
      ],
      "sources": [
        {
          "from": "./apps/docs/build",
          "to": "./"
        }
      ]
    }
  },
  "ignoreFiles": {
    "./.gitignore": {
      "bundles": [
        "nova"
      ],
      "patterns": [
        "/assets/",
        "!package-lock.json",
        "graphify-out/"
      ]
    }
  },
  "agents": [
    "claude-code",
    "codex"
  ],
  "recipes": {
    "github": {
      "sync-actions": {
