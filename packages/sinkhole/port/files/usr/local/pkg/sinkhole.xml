	<fields>
		<field>
			<type>listtopic</type>
			<name>General</name>
		</field>
		<field>
			<fielddescr>Enable</fielddescr>
			<fieldname>enabled</fieldname>
			<type>checkbox</type>
			<description>Enable scheduled list updates and DNS Resolver integration.</description>
		</field>
		<field>
			<fielddescr>Update Frequency</fielddescr>
			<fieldname>update_frequency</fieldname>
			<type>select</type>
			<default_value>daily</default_value>
			<options>
				<option><name>Hourly</name><value>hourly</value></option>
				<option><name>Every 6 hours</name><value>every_six_hours</value></option>
				<option><name>Daily</name><value>daily</value></option>
				<option><name>Weekly</name><value>weekly</value></option>
			</options>
			<description>Choose how often enabled block lists update.</description>
		</field>
		<field>
			<fielddescr>Keep Settings</fielddescr>
			<fieldname>keep_settings</fieldname>
			<type>checkbox</type>
			<default_value>on</default_value>
			<description>Keep lists and settings when the package is removed.</description>
		</field>
		<field>
			<type>listtopic</type>
			<name>Package Updates</name>
		</field>
		<field>
			<fielddescr>Update Checks</fielddescr>
			<fieldname>update_check_frequency</fieldname>
			<type>select</type>
			<default_value>weekly</default_value>
			<options>
				<option><name>Daily</name><value>daily</value></option>
				<option><name>Weekly</name><value>weekly</value></option>
				<option><name>Monthly</name><value>monthly</value></option>
				<option><name>Never</name><value>never</value></option>
			</options>
			<description>Check GitHub for new Sinkhole releases on a stable randomized schedule.</description>
		</field>
		<field>
			<fielddescr>Remote Notifications</fielddescr>
			<fieldname>update_remote_notifications</fieldname>
			<type>checkbox</type>
			<description>Also send each new-version notice through configured pfSense remote notification services.</description>
		</field>
	</fields>
	<custom_php_install_command>
		pfsensePackageSinkholeInstall();
	</custom_php_install_command>
	<custom_php_resync_config_command>
		pfsensePackageSinkholeSync();
	</custom_php_resync_config_command>
	<custom_php_deinstall_command>
		pfsensePackageSinkholePackageDeinstall();
	</custom_php_deinstall_command>
	<custom_delete_php_command>
		pfsensePackageSinkholeDelete();
	</custom_delete_php_command>
